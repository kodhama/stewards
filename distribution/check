#!/usr/bin/env python3
"""Repository quality gate for the implemented spec-0001 slice."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from typing import Optional


ROOT = Path(__file__).resolve().parents[1]


def run(command: list[str], env: dict[str, str]) -> None:
    result = subprocess.run(
        command,
        cwd=ROOT,
        env=env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    if result.stdout:
        sys.stdout.write(result.stdout)
    if result.returncode:
        raise SystemExit(result.returncode)


def diff_check_commands(base_sha: Optional[str]) -> list[list[str]]:
    commands = [
        ["git", "diff", "--check"],
        ["git", "diff", "--cached", "--check"],
    ]
    if (
        isinstance(base_sha, str)
        and re.fullmatch(r"[0-9a-f]{40}", base_sha)
        and base_sha != "0" * 40
    ):
        commands.append(["git", "diff", "--check", f"{base_sha}..HEAD"])
    return commands


def main() -> int:
    env = os.environ.copy()
    env["STEWARDS_CHECK_INNER"] = "1"
    with tempfile.TemporaryDirectory(prefix="stewards-pycache-") as pycache:
        env["PYTHONPYCACHEPREFIX"] = pycache

        run(
            [
                sys.executable,
                "-m",
                "unittest",
                "discover",
                "-s",
                "distribution/tests",
                "-v",
            ],
            env,
        )
        run(["distribution/manage", "validate-door"], env)
        run(["distribution/manage", "generate", "--check"], env)
        run(["distribution/python-lint"], env)
        run([sys.executable, "-m", "compileall", "-q", "distribution"], env)
        run(
            [
                sys.executable,
                "-m",
                "py_compile",
                "distribution/manage",
                "distribution/provision",
                "distribution/check",
                "distribution/python-lint",
                "distribution/lib/manage.py",
                "distribution/lib/provision.py",
            ],
            env,
        )

        for path in sorted((ROOT / "distribution").rglob("*.json")):
            try:
                json.loads(path.read_text(encoding="utf-8"))
            except (OSError, UnicodeError, json.JSONDecodeError) as exc:
                print(f"{path.relative_to(ROOT)}: {exc}", file=sys.stderr)
                return 1

        for command in diff_check_commands(env.get("STEWARDS_BASE_SHA")):
            run(command, env)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
