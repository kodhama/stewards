{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodhama/stewards/distribution/schemas/provision-entrypoints.v1.schema.json",
  "title": "Declared and discovered launch entrypoints v1",
  "type": "object",
  "required": [
    "schema_version",
    "host",
    "host_version",
    "adapter_version",
    "launch_entrypoints",
    "discovery",
    "declaration_sha256",
    "discovery_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "host": { "enum": ["claude-code", "codex"] },
    "host_version": { "type": "string", "minLength": 1 },
    "adapter_version": {
      "$ref": "common-types.v1.schema.json#/$defs/semver"
    },
    "launch_entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/declaration" }
    },
    "discovery": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/discovery_row" }
    },
    "declaration_sha256": {
      "$ref": "common-types.v1.schema.json#/$defs/sha256"
    },
    "discovery_sha256": {
      "$ref": "common-types.v1.schema.json#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "absolute_path": {
      "type": "string",
      "pattern": "^/(?!$)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\u0000)(?:[^/]+/)*[^/]+$"
    },
    "declaration": {
      "type": "object",
      "required": ["entrypoint_id", "command_name"],
      "properties": {
        "entrypoint_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        },
        "command_name": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        }
      },
      "additionalProperties": false
    },
    "discovery_row": {
      "type": "object",
      "required": [
        "entrypoint_id",
        "command_name",
        "invoked_path",
        "real_path",
        "real_sha256"
      ],
      "properties": {
        "entrypoint_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        },
        "command_name": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        },
        "invoked_path": { "$ref": "#/$defs/absolute_path" },
        "real_path": { "$ref": "#/$defs/absolute_path" },
        "real_sha256": {
          "$ref": "common-types.v1.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
