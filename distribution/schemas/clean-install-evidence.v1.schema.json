{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodhama/stewards/distribution/schemas/clean-install-evidence.v1.schema.json",
  "title": "Clean install evidence v1",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "subject",
    "catalog_key",
    "distribution_binding",
    "clean_environment",
    "installation",
    "observations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_id": {
      "$ref": "common-types.v1.schema.json#/$defs/dot_id"
    },
    "subject": {
      "$ref": "common-types.v1.schema.json#/$defs/release_subject"
    },
    "catalog_key": {
      "type": "object",
      "required": ["plugin_id", "surface_id"],
      "properties": {
        "plugin_id": {
          "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
        },
        "surface_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        }
      },
      "additionalProperties": false
    },
    "distribution_binding": {
      "$ref": "common-types.v1.schema.json#/$defs/distribution_binding"
    },
    "clean_environment": {
      "type": "object",
      "required": [
        "host",
        "host_version",
        "environment",
        "mode",
        "snapshot_kind",
        "snapshot_id",
        "sha256"
      ],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "host_version": { "type": "string", "minLength": 1 },
        "environment": { "enum": ["local", "ci", "cloud-container"] },
        "mode": { "enum": ["interactive", "headless"] },
        "snapshot_kind": {
          "enum": ["machine-snapshot", "ci-image", "container-image"]
        },
        "snapshot_id": { "type": "string", "minLength": 1 },
        "sha256": {
          "$ref": "common-types.v1.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "installation": {
      "type": "object",
      "required": [
        "started_at",
        "finished_at",
        "outcome",
        "discovered_identity",
        "record_reference"
      ],
      "properties": {
        "started_at": {
          "$ref": "common-types.v1.schema.json#/$defs/timestamp"
        },
        "finished_at": {
          "$ref": "common-types.v1.schema.json#/$defs/timestamp"
        },
        "outcome": { "const": "installed" },
        "discovered_identity": {
          "$ref": "common-types.v1.schema.json#/$defs/release_subject"
        },
        "record_reference": {
          "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
        }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common-types.v1.schema.json#/$defs/evidence_binding"
      }
    }
  },
  "additionalProperties": false
}
