{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodhama/stewards/distribution/schemas/provision-evidence-bundle.v1.schema.json",
  "title": "Retained two-run provision evidence manifest v1",
  "type": "object",
  "required": ["schema_version", "identity", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "identity": { "$ref": "#/$defs/identity" },
    "files": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/file" },
      "allOf": [
        { "$ref": "#/$defs/has_request" },
        { "$ref": "#/$defs/has_environment" },
        { "$ref": "#/$defs/has_entrypoints" },
        { "$ref": "#/$defs/has_state_initial" },
        { "$ref": "#/$defs/has_state_run_1" },
        { "$ref": "#/$defs/has_state_run_2" },
        { "$ref": "#/$defs/has_receipt_run_1" },
        { "$ref": "#/$defs/has_receipt_run_2" },
        { "$ref": "#/$defs/has_launch_events" },
        { "$ref": "#/$defs/has_write_events_run_1" },
        { "$ref": "#/$defs/has_write_events_run_2" },
        { "$ref": "#/$defs/has_harness" }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "has_request": {
      "contains": {
        "properties": { "path": { "const": "request.json" } },
        "required": ["path"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "has_environment": {
      "contains": {
        "properties": { "path": { "const": "environment.json" } },
        "required": ["path"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "has_entrypoints": {
      "contains": {
        "properties": { "path": { "const": "entrypoints.json" } },
        "required": ["path"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "has_state_initial": {
      "contains": {
        "properties": { "path": { "const": "state-initial.json" } },
        "required": ["path"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "has_state_run_1": {
      "contains": {
        "properties": { "path": { "const": "state-run-1.json" } },
        "required": ["path"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "has_state_run_2": {
      "contains": {
        "properties": { "path": { "const": "state-run-2.json" } },
        "required": ["path"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "has_receipt_run_1": {
      "contains": {
        "properties": { "path": { "const": "run-1.receipt.json" } },
        "required": ["path"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "has_receipt_run_2": {
      "contains": {
        "properties": { "path": { "const": "run-2.receipt.json" } },
        "required": ["path"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "has_launch_events": {
      "contains": {
        "properties": { "path": { "const": "launch-events.json" } },
        "required": ["path"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "has_write_events_run_1": {
      "contains": {
        "properties": { "path": { "const": "run-1.write-events.json" } },
        "required": ["path"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "has_write_events_run_2": {
      "contains": {
        "properties": { "path": { "const": "run-2.write-events.json" } },
        "required": ["path"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "has_harness": {
      "contains": {
        "properties": { "path": { "const": "harness.json" } },
        "required": ["path"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "identity": {
      "type": "object",
      "required": [
        "route_id",
        "surface_id",
        "plugin_id",
        "package_version",
        "provisioner_version"
      ],
      "properties": {
        "route_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        },
        "surface_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        },
        "plugin_id": {
          "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
        },
        "package_version": {
          "$ref": "common-types.v1.schema.json#/$defs/semver"
        },
        "provisioner_version": {
          "$ref": "common-types.v1.schema.json#/$defs/semver"
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "enum": [
            "request.json",
            "environment.json",
            "entrypoints.json",
            "state-initial.json",
            "state-run-1.json",
            "state-run-2.json",
            "run-1.receipt.json",
            "run-2.receipt.json",
            "launch-events.json",
            "run-1.write-events.json",
            "run-2.write-events.json",
            "harness.json"
          ]
        },
        "sha256": {
          "$ref": "common-types.v1.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
