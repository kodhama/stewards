{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodhama/stewards/distribution/schemas/catalog-availability.v1.schema.json",
  "title": "Catalog availability v1",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "key": {
      "type": "object",
      "required": ["plugin_id", "surface_id"],
      "properties": {
        "plugin_id": {
          "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
        },
        "surface_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        }
      }
    },
    "host_projection": {
      "type": "object",
      "required": ["host", "entry_name", "fields"],
      "properties": {
        "host": { "enum": ["claude-code", "codex"] },
        "entry_name": {
          "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
        },
        "fields": { "type": "object" }
      },
      "additionalProperties": false
    },
    "transition_exception": {
      "type": "object",
      "required": [
        "baseline_key",
        "selector_fingerprint",
        "missing_contract_elements",
        "disclosure",
        "terminal_action"
      ],
      "properties": {
        "baseline_key": {
          "type": "object",
          "required": ["plugin_id", "surface_id"],
          "properties": {
            "plugin_id": {
              "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
            },
            "surface_id": {
              "$ref": "common-types.v1.schema.json#/$defs/dot_id"
            }
          },
          "additionalProperties": false
        },
        "selector_fingerprint": {
          "$ref": "common-types.v1.schema.json#/$defs/sha256"
        },
        "missing_contract_elements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "disclosure": { "const": "legacy published stock" },
        "terminal_action": { "const": "adopt-or-delist" }
      },
      "additionalProperties": false
    },
    "published_common": {
      "type": "object",
      "required": [
        "plugin_id",
        "surface_id",
        "state",
        "manifest_path",
        "source_selector",
        "publication_evidence",
        "host_projection"
      ],
      "properties": {
        "plugin_id": {
          "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
        },
        "surface_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        },
        "state": { "enum": ["published", "verified"] },
        "manifest_path": {
          "enum": [
            ".claude-plugin/marketplace.json",
            ".agents/plugins/marketplace.json"
          ]
        },
        "source_selector": {
          "$ref": "common-types.v1.schema.json#/$defs/source_selector"
        },
        "publication_evidence": {
          "$ref": "common-types.v1.schema.json#/$defs/publication_evidence"
        },
        "host_projection": { "$ref": "#/$defs/host_projection" },
        "release_metadata_path": {
          "$ref": "common-types.v1.schema.json#/$defs/relative_path"
        },
        "surface_contract_path": {
          "$ref": "common-types.v1.schema.json#/$defs/relative_path"
        },
        "product_contract_version": { "const": 1 },
        "transition_exception": { "$ref": "#/$defs/transition_exception" },
        "package_version": {
          "$ref": "common-types.v1.schema.json#/$defs/semver"
        },
        "release_tag": {
          "$ref": "common-types.v1.schema.json#/$defs/release_tag"
        },
        "source_commit": {
          "$ref": "common-types.v1.schema.json#/$defs/source_commit"
        },
        "identity_binding": {
          "$ref": "common-types.v1.schema.json#/$defs/distribution_binding"
        },
        "clean_install_evidence": {
          "$ref": "clean-install-evidence.v1.schema.json"
        },
        "release_history_reference": {
          "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
        }
      }
    },
    "record": {
      "oneOf": [
        {
          "type": "object",
          "required": ["plugin_id", "surface_id", "state", "reason"],
          "properties": {
            "plugin_id": {
              "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
            },
            "surface_id": {
              "$ref": "common-types.v1.schema.json#/$defs/dot_id"
            },
            "state": { "const": "absent" },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/published_common" },
            {
              "type": "object",
              "required": [
                "release_metadata_path",
                "surface_contract_path",
                "product_contract_version"
              ],
              "properties": { "state": { "const": "published" } },
              "not": { "required": ["transition_exception"] }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/published_common" },
            {
              "type": "object",
              "required": ["transition_exception"],
              "properties": { "state": { "const": "published" } },
              "not": {
                "anyOf": [
                  { "required": ["release_metadata_path"] },
                  { "required": ["surface_contract_path"] },
                  { "required": ["product_contract_version"] }
                ]
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/published_common" },
            {
              "type": "object",
              "required": [
                "release_metadata_path",
                "surface_contract_path",
                "product_contract_version",
                "package_version",
                "release_tag",
                "source_commit",
                "identity_binding",
                "clean_install_evidence",
                "release_history_reference"
              ],
              "properties": { "state": { "const": "verified" } },
              "not": { "required": ["transition_exception"] }
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    }
  }
}
