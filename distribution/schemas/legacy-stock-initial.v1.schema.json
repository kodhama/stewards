{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodhama/stewards/distribution/schemas/legacy-stock-initial.v1.schema.json",
  "title": "Immutable initial transition stock v1",
  "type": "object",
  "required": ["schema_version", "rows"],
  "properties": {
    "schema_version": { "const": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/stock_row" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stock_row": {
      "type": "object",
      "required": [
        "plugin_id",
        "surface_id",
        "manifest_path",
        "selector_fingerprint",
        "missing_contract_elements",
        "disclosure",
        "terminal_action"
      ],
      "properties": {
        "plugin_id": { "const": "trellis" },
        "surface_id": { "const": "claude-code.local.interactive" },
        "manifest_path": { "const": ".claude-plugin/marketplace.json" },
        "selector_fingerprint": {
          "$ref": "common-types.v1.schema.json#/$defs/sha256"
        },
        "missing_contract_elements": {
          "const": [
            "canonical-semver-authority",
            "immutable-release-tag",
            "product-adoption-decision",
            "version-bound-surface-contract"
          ]
        },
        "disclosure": { "const": "legacy published stock" },
        "terminal_action": { "const": "adopt-or-delist" }
      },
      "additionalProperties": false
    }
  }
}
