{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodhama/stewards/distribution/schemas/effective-facts.v1.schema.json",
  "title": "Authoritative effective-support facts v1",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "product_contract",
    "distribution_record",
    "consumer_selection",
    "environment_assessment",
    "product_setup"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "subject": {
      "$ref": "common-types.v1.schema.json#/$defs/release_subject"
    },
    "product_contract": { "$ref": "#/$defs/product_contract" },
    "distribution_record": { "$ref": "#/$defs/distribution_record" },
    "consumer_selection": { "$ref": "#/$defs/consumer_selection" },
    "environment_assessment": {
      "$ref": "#/$defs/environment_assessment"
    },
    "product_setup": { "$ref": "#/$defs/product_setup" }
  },
  "additionalProperties": false,
  "$defs": {
    "error_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "product_contract": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "source_reference", "subject", "row"],
          "properties": {
            "kind": { "const": "record" },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "subject": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            },
            "row": {
              "$ref": "surface-contract.v1.schema.json#/$defs/surface_row"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "source_reference", "lookup"],
          "properties": {
            "kind": { "const": "missing" },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "lookup": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "source_reference", "lookup", "errors"],
          "properties": {
            "kind": { "const": "invalid" },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "lookup": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            },
            "errors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "row-schema-invalid",
                  "duplicate-surface",
                  "stable-reference-mismatch"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "catalog_lookup": {
      "type": "object",
      "required": ["plugin_id", "surface_id"],
      "properties": {
        "plugin_id": {
          "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
        },
        "surface_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        }
      },
      "additionalProperties": false
    },
    "provisioner_lookup": {
      "type": "object",
      "required": [
        "route_id",
        "surface_id",
        "plugin_id",
        "package_version"
      ],
      "properties": {
        "route_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        },
        "surface_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        },
        "plugin_id": {
          "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
        },
        "package_version": {
          "$ref": "common-types.v1.schema.json#/$defs/semver"
        }
      },
      "additionalProperties": false
    },
    "distribution_record": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "source_reference",
            "record_type",
            "record"
          ],
          "properties": {
            "kind": { "const": "record" },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "record_type": { "enum": ["catalog", "provisioner"] },
            "record": {
              "oneOf": [
                {
                  "$ref": "catalog-availability.v1.schema.json#/$defs/record"
                },
                {
                  "$ref": "provisioner-availability.v1.schema.json#/$defs/record"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source_reference",
            "record_type",
            "lookup_key"
          ],
          "properties": {
            "kind": { "const": "missing" },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "record_type": { "enum": ["catalog", "provisioner"] },
            "lookup_key": {
              "oneOf": [
                { "$ref": "#/$defs/catalog_lookup" },
                { "$ref": "#/$defs/provisioner_lookup" }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source_reference",
            "record_type",
            "lookup_key",
            "error_codes"
          ],
          "properties": {
            "kind": { "const": "invalid" },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "record_type": { "enum": ["catalog", "provisioner"] },
            "lookup_key": {
              "oneOf": [
                { "$ref": "#/$defs/catalog_lookup" },
                { "$ref": "#/$defs/provisioner_lookup" }
              ]
            },
            "error_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "row-schema-invalid",
                  "duplicate-key",
                  "stable-reference-mismatch"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "consumer_selection": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "request_id",
            "plugin_id",
            "package_version",
            "surface_id",
            "route_id",
            "source_reference"
          ],
          "properties": {
            "state": { "const": "selected" },
            "request_id": {
              "$ref": "common-types.v1.schema.json#/$defs/dot_id"
            },
            "plugin_id": {
              "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
            },
            "package_version": {
              "$ref": "common-types.v1.schema.json#/$defs/semver"
            },
            "surface_id": {
              "$ref": "common-types.v1.schema.json#/$defs/dot_id"
            },
            "route_id": {
              "$ref": "common-types.v1.schema.json#/$defs/dot_id"
            },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["state", "subject", "source_reference"],
          "properties": {
            "state": { "const": "missing" },
            "subject": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["state", "subject", "source_reference", "errors"],
          "properties": {
            "state": { "const": "invalid" },
            "subject": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "errors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "selection-mismatch",
                  "selection-reference-invalid"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "environment_assessment": {
      "oneOf": [
        {
          "type": "object",
          "required": ["state", "subject", "evidence", "source_reference"],
          "properties": {
            "state": { "const": "ready" },
            "subject": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common-types.v1.schema.json#/$defs/evidence_binding"
              }
            },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "subject",
            "evidence",
            "source_reference",
            "missing_prerequisites"
          ],
          "properties": {
            "state": { "const": "not-ready" },
            "subject": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common-types.v1.schema.json#/$defs/evidence_binding"
              }
            },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "missing_prerequisites": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["state", "subject", "source_reference"],
          "properties": {
            "state": { "const": "missing" },
            "subject": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["state", "subject", "source_reference", "errors"],
          "properties": {
            "state": { "const": "invalid" },
            "subject": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "errors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "assessment-schema-invalid",
                  "assessment-reference-invalid",
                  "assessment-identity-mismatch"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "product_setup": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "subject",
            "state",
            "requirement_reference",
            "contract"
          ],
          "properties": {
            "subject": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            },
            "state": { "const": "not-required" },
            "requirement_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "contract": { "type": "null" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "subject",
            "state",
            "requirement_reference",
            "contract",
            "completion_reference",
            "completion_identity"
          ],
          "properties": {
            "subject": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            },
            "state": { "const": "complete" },
            "requirement_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "contract": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "completion_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "completion_identity": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "subject",
            "state",
            "requirement_reference",
            "contract",
            "reason_code",
            "reason_source"
          ],
          "properties": {
            "subject": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            },
            "state": { "const": "incomplete" },
            "requirement_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "contract": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "reason_code": { "enum": ["setup-not-run", "setup-failed"] },
            "reason_source": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["subject", "state", "missing_kind", "source_reference"],
          "properties": {
            "subject": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            },
            "state": { "const": "missing" },
            "missing_kind": {
              "enum": ["product-requirement", "completion-proof"]
            },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["subject", "state", "source_reference", "error_codes"],
          "properties": {
            "subject": {
              "$ref": "common-types.v1.schema.json#/$defs/release_subject"
            },
            "state": { "const": "invalid" },
            "source_reference": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            },
            "error_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "product-requirement-invalid",
                  "consumer-setup-fact-invalid",
                  "setup-identity-mismatch"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
