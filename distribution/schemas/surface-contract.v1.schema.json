{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodhama/stewards/distribution/schemas/surface-contract.v1.schema.json",
  "title": "Product surface contract v1",
  "type": "object",
  "required": [
    "schema_version",
    "family_contract_version",
    "version",
    "surfaces"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "family_contract_version": { "const": 1 },
    "version": { "$ref": "common-types.v1.schema.json#/$defs/semver" },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "setup": {
      "type": "object",
      "required": ["required", "contract"],
      "properties": {
        "required": { "type": "boolean" },
        "contract": {
          "oneOf": [
            { "type": "null" },
            {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "required": { "const": true } } },
          "then": {
            "properties": {
              "contract": {
                "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
              }
            }
          },
          "else": { "properties": { "contract": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    },
    "surface_row": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "surface_id",
            "host",
            "status",
            "post_install_setup",
            "evidence",
            "load_path",
            "support_record"
          ],
          "properties": {
            "surface_id": {
              "$ref": "common-types.v1.schema.json#/$defs/dot_id"
            },
            "host": { "type": "string", "minLength": 1 },
            "status": { "const": "supported" },
            "post_install_setup": { "$ref": "#/$defs/setup" },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common-types.v1.schema.json#/$defs/evidence_binding"
              }
            },
            "load_path": {
              "$ref": "common-types.v1.schema.json#/$defs/load_path"
            },
            "support_record": {
              "$ref": "common-types.v1.schema.json#/$defs/support_record"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "surface_id",
            "host",
            "status",
            "post_install_setup",
            "missing_capability",
            "disclosure"
          ],
          "properties": {
            "surface_id": {
              "$ref": "common-types.v1.schema.json#/$defs/dot_id"
            },
            "host": { "type": "string", "minLength": 1 },
            "status": { "enum": ["candidate", "unsupported"] },
            "post_install_setup": { "$ref": "#/$defs/setup" },
            "missing_capability": { "type": "string", "minLength": 1 },
            "disclosure": { "type": "string", "minLength": 1 },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common-types.v1.schema.json#/$defs/evidence_binding"
              }
            },
            "load_path": {
              "$ref": "common-types.v1.schema.json#/$defs/load_path"
            },
            "support_record": {
              "$ref": "common-types.v1.schema.json#/$defs/support_record"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
