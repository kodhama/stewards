{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodhama/stewards/distribution/schemas/common-types.v1.schema.json",
  "title": "Kodhama family distribution common types v1",
  "type": "object",
  "properties": {},
  "additionalProperties": false,
  "$defs": {
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "dot_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "release_tag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*$"
    },
    "relative_or_root_path": {
      "type": "string",
      "pattern": "^(?:|(?!(?:/|.*(?:^|/)(?:\\.|\\.\\.)(?:/|$)|.*//))[^/]+(?:/[^/]+)*)$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "not": {
        "pattern": "\\.git$"
      }
    },
    "version_extractor": {
      "oneOf": [
        {
          "type": "object",
          "required": ["path", "format"],
          "properties": {
            "path": { "$ref": "#/$defs/relative_path" },
            "format": { "const": "plain-text" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["path", "format", "selector"],
          "properties": {
            "path": { "$ref": "#/$defs/relative_path" },
            "format": { "const": "json" },
            "selector": {
              "type": "string",
              "pattern": "^(?:|(?:/(?:[^~/]|~[01])*)+)$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "version_carrier": {
      "type": "object",
      "required": ["carrier_id", "role", "path", "format"],
      "properties": {
        "carrier_id": { "$ref": "#/$defs/dot_id" },
        "role": {
          "enum": ["host-manifest", "package-manifest", "other"]
        },
        "path": { "$ref": "#/$defs/relative_path" },
        "format": { "enum": ["plain-text", "json"] },
        "selector": {
          "type": "string",
          "pattern": "^(?:|(?:/(?:[^~/]|~[01])*)+)$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "format": { "const": "plain-text" } } },
          "then": { "not": { "required": ["selector"] } },
          "else": { "required": ["selector"] }
        }
      ],
      "additionalProperties": false
    },
    "stable_reference": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "repository", "source_commit", "path", "sha256"],
          "properties": {
            "kind": { "const": "repo-path" },
            "repository": { "$ref": "#/$defs/repository" },
            "source_commit": { "$ref": "#/$defs/source_commit" },
            "path": { "$ref": "#/$defs/relative_path" },
            "sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "url", "sha256"],
          "properties": {
            "kind": { "const": "https-url" },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^@/#]+(?:/[^#]*)?$"
            },
            "sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "uri", "sha256"],
          "properties": {
            "kind": { "const": "artifact" },
            "uri": { "type": "string", "format": "uri" },
            "sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      ]
    },
    "release_subject": {
      "type": "object",
      "required": [
        "plugin_id",
        "package_version",
        "release_tag",
        "source_commit",
        "surface_id"
      ],
      "properties": {
        "plugin_id": { "$ref": "#/$defs/plugin_id" },
        "package_version": { "$ref": "#/$defs/semver" },
        "release_tag": { "$ref": "#/$defs/release_tag" },
        "source_commit": { "$ref": "#/$defs/source_commit" },
        "surface_id": { "$ref": "#/$defs/dot_id" }
      },
      "additionalProperties": false
    },
    "evidence_binding": {
      "type": "object",
      "required": [
        "evidence_id",
        "stable_reference",
        "plugin_id",
        "package_version",
        "release_tag",
        "source_commit",
        "surface_id",
        "observed_at",
        "observation"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/dot_id" },
        "stable_reference": { "$ref": "#/$defs/stable_reference" },
        "plugin_id": { "$ref": "#/$defs/plugin_id" },
        "package_version": { "$ref": "#/$defs/semver" },
        "release_tag": { "$ref": "#/$defs/release_tag" },
        "source_commit": { "$ref": "#/$defs/source_commit" },
        "surface_id": { "$ref": "#/$defs/dot_id" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "observation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "load_path": {
      "type": "object",
      "required": ["kind", "locator"],
      "properties": {
        "kind": {
          "enum": ["command", "skill", "agent", "hook", "connector", "host-discovery"]
        },
        "locator": { "type": "string", "minLength": 1 },
        "invocation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "support_record": {
      "type": "object",
      "required": [
        "record_id",
        "stable_reference",
        "plugin_id",
        "package_version",
        "surface_id"
      ],
      "properties": {
        "record_id": { "$ref": "#/$defs/dot_id" },
        "stable_reference": { "$ref": "#/$defs/stable_reference" },
        "plugin_id": { "$ref": "#/$defs/plugin_id" },
        "package_version": { "$ref": "#/$defs/semver" },
        "surface_id": { "$ref": "#/$defs/dot_id" }
      },
      "additionalProperties": false
    },
    "publication_evidence": {
      "type": "object",
      "required": [
        "stable_reference",
        "manifest_path",
        "manifest_sha256",
        "observed_at"
      ],
      "properties": {
        "stable_reference": { "$ref": "#/$defs/stable_reference" },
        "manifest_path": { "$ref": "#/$defs/relative_path" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "observed_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "source_selector": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "repository", "path"],
          "properties": {
            "kind": { "const": "mutable" },
            "repository": { "$ref": "#/$defs/repository" },
            "path": { "$ref": "#/$defs/relative_or_root_path" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "repository", "path", "ref"],
          "properties": {
            "kind": { "const": "immutable" },
            "repository": { "$ref": "#/$defs/repository" },
            "path": { "$ref": "#/$defs/relative_or_root_path" },
            "ref": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["kind", "value"],
                  "properties": {
                    "kind": { "const": "tag" },
                    "value": { "$ref": "#/$defs/release_tag" }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": ["kind", "value"],
                  "properties": {
                    "kind": { "const": "commit" },
                    "value": { "$ref": "#/$defs/source_commit" }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "distribution_binding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "selector"],
          "properties": {
            "kind": { "const": "catalog-selector" },
            "selector": {
              "allOf": [
                { "$ref": "#/$defs/source_selector" },
                { "properties": { "kind": { "const": "immutable" } } }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "provisioner_identity", "evidence_bundle"],
          "properties": {
            "kind": { "const": "provisioner-acquisition" },
            "provisioner_identity": {
              "type": "object",
              "required": [
                "route_id",
                "surface_id",
                "plugin_id",
                "package_version",
                "provisioner_version",
                "release_tag",
                "source_commit"
              ],
              "properties": {
                "route_id": { "$ref": "#/$defs/dot_id" },
                "surface_id": { "$ref": "#/$defs/dot_id" },
                "plugin_id": { "$ref": "#/$defs/plugin_id" },
                "package_version": { "$ref": "#/$defs/semver" },
                "provisioner_version": { "$ref": "#/$defs/semver" },
                "release_tag": { "$ref": "#/$defs/release_tag" },
                "source_commit": { "$ref": "#/$defs/source_commit" }
              },
              "additionalProperties": false
            },
            "evidence_bundle": { "$ref": "#/$defs/stable_reference" }
          },
          "additionalProperties": false
        }
      ]
    },
    "retirement": {
      "type": "object",
      "required": ["retired_at", "decision_ref", "replaced_by"],
      "properties": {
        "retired_at": { "$ref": "#/$defs/timestamp" },
        "decision_ref": { "$ref": "#/$defs/dot_id" },
        "replaced_by": { "$ref": "#/$defs/dot_id" }
      },
      "additionalProperties": false
    }
  }
}
