{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodhama/stewards/distribution/schemas/provision-write-events.v1.schema.json",
  "title": "Provisioner process-tree write audit v1",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "exempt_output_paths",
    "preflight_allowed_write_set",
    "tuple_allowed_write_sets",
    "events",
    "sealed_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        { "type": "null" }
      ]
    },
    "exempt_output_paths": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/absolute_path" }
    },
    "preflight_allowed_write_set": {
      "type": "array",
      "items": { "$ref": "#/$defs/allowed_write" }
    },
    "tuple_allowed_write_sets": {
      "type": "array",
      "items": { "$ref": "#/$defs/tuple_allowed_write_set" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/write_event" }
    },
    "sealed_at": {
      "$ref": "common-types.v1.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "absolute_path": {
      "type": "string",
      "pattern": "^/(?!$)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\u0000)(?:[^/]+/)*[^/]+$"
    },
    "nullable_sha256": {
      "oneOf": [
        { "$ref": "common-types.v1.schema.json#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "allowed_write": {
      "type": "object",
      "required": ["path", "match", "classification"],
      "properties": {
        "path": { "$ref": "#/$defs/absolute_path" },
        "match": { "enum": ["exact", "subtree"] },
        "classification": {
          "enum": [
            "receipt-evidence-scratch",
            "selected-package",
            "selected-kodhama-catalog"
          ]
        }
      },
      "additionalProperties": false
    },
    "tuple_allowed_write_set": {
      "type": "object",
      "required": ["result_id", "allowed_writes", "sha256"],
      "properties": {
        "result_id": {
          "type": "string",
          "pattern": "^t(?:0|[1-9][0-9]*)\\.p(?:0|[1-9][0-9]*)$"
        },
        "allowed_writes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/allowed_write" }
        },
        "sha256": {
          "$ref": "common-types.v1.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "write_event": {
      "type": "object",
      "required": [
        "sequence",
        "result_id",
        "operation",
        "path",
        "process_id",
        "before_sha256",
        "after_sha256",
        "classification"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "result_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^t(?:0|[1-9][0-9]*)\\.p(?:0|[1-9][0-9]*)$"
            },
            { "type": "null" }
          ]
        },
        "operation": {
          "enum": ["create", "modify", "delete"]
        },
        "path": { "$ref": "#/$defs/absolute_path" },
        "process_id": { "type": "integer", "minimum": 1 },
        "before_sha256": { "$ref": "#/$defs/nullable_sha256" },
        "after_sha256": { "$ref": "#/$defs/nullable_sha256" },
        "classification": {
          "enum": [
            "receipt-evidence-scratch",
            "selected-package",
            "selected-kodhama-catalog",
            "outside-allowed-write"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "operation": { "const": "create" } },
            "required": ["operation"]
          },
          "then": {
            "properties": {
              "before_sha256": { "type": "null" },
              "after_sha256": {
                "$ref": "common-types.v1.schema.json#/$defs/sha256"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "operation": { "const": "delete" } },
            "required": ["operation"]
          },
          "then": {
            "properties": {
              "before_sha256": {
                "$ref": "common-types.v1.schema.json#/$defs/sha256"
              },
              "after_sha256": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "operation": { "const": "modify" } },
            "required": ["operation"]
          },
          "then": {
            "properties": {
              "before_sha256": {
                "$ref": "common-types.v1.schema.json#/$defs/sha256"
              },
              "after_sha256": {
                "$ref": "common-types.v1.schema.json#/$defs/sha256"
              }
            }
          }
        }
      ]
    }
  }
}
