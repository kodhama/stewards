{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodhama/stewards/distribution/schemas/release-metadata.v1.schema.json",
  "title": "Product release metadata v1",
  "type": "object",
  "required": [
    "schema_version",
    "family_contract_version",
    "plugin_id",
    "version_authority",
    "version_carriers",
    "surface_contract",
    "release_inventory",
    "release_history",
    "inventory_provider"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "family_contract_version": { "const": 1 },
    "plugin_id": {
      "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
    },
    "version_authority": {
      "$ref": "common-types.v1.schema.json#/$defs/version_extractor"
    },
    "version_carriers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common-types.v1.schema.json#/$defs/version_carrier"
      }
    },
    "surface_contract": {
      "$ref": "common-types.v1.schema.json#/$defs/relative_path"
    },
    "release_inventory": {
      "$ref": "common-types.v1.schema.json#/$defs/relative_path"
    },
    "release_history": {
      "$ref": "common-types.v1.schema.json#/$defs/relative_path"
    },
    "inventory_provider": {
      "$ref": "common-types.v1.schema.json#/$defs/relative_path"
    },
    "release_approval": {
      "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
    },
    "payload_identity": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "validator": {
            "$ref": "common-types.v1.schema.json#/$defs/relative_path"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
