{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodhama/stewards/distribution/schemas/release-history.v1.schema.json",
  "title": "Append-only product release history v1",
  "type": "object",
  "required": ["schema_version", "releases"],
  "properties": {
    "schema_version": { "const": 1 },
    "releases": {
      "type": "array",
      "items": { "$ref": "#/$defs/release" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "payload_identity": {
      "type": "object",
      "required": ["payload_id", "kind", "value"],
      "properties": {
        "payload_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        },
        "kind": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": [
        "contract_id",
        "change_kind",
        "before_fingerprint",
        "after_fingerprint",
        "evidence_refs"
      ],
      "properties": {
        "contract_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        },
        "change_kind": {
          "enum": [
            "backward-compatible-fix",
            "backward-compatible-capability",
            "supported-surface-addition",
            "breaking-change",
            "false-claim-correction",
            "supported-surface-withdrawal"
          ]
        },
        "before_fingerprint": {
          "oneOf": [
            { "type": "null" },
            {
              "$ref": "common-types.v1.schema.json#/$defs/sha256"
            }
          ]
        },
        "after_fingerprint": {
          "oneOf": [
            { "type": "null" },
            {
              "$ref": "common-types.v1.schema.json#/$defs/sha256"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
          }
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "package_version",
        "release_tag",
        "source_commit",
        "release_inventory_sha256",
        "payload_identities",
        "public_contract_inventory_sha256",
        "surface_contract_sha256",
        "change_set",
        "release_approval"
      ],
      "properties": {
        "package_version": {
          "$ref": "common-types.v1.schema.json#/$defs/semver"
        },
        "release_tag": {
          "$ref": "common-types.v1.schema.json#/$defs/release_tag"
        },
        "source_commit": {
          "$ref": "common-types.v1.schema.json#/$defs/source_commit"
        },
        "release_inventory_sha256": {
          "$ref": "common-types.v1.schema.json#/$defs/sha256"
        },
        "payload_identities": {
          "type": "array",
          "items": { "$ref": "#/$defs/payload_identity" }
        },
        "public_contract_inventory_sha256": {
          "$ref": "common-types.v1.schema.json#/$defs/sha256"
        },
        "surface_contract_sha256": {
          "$ref": "common-types.v1.schema.json#/$defs/sha256"
        },
        "change_set": {
          "type": "array",
          "items": { "$ref": "#/$defs/change" }
        },
        "release_approval": {
          "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
        },
        "prior_history_reference": {
          "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
        }
      },
      "additionalProperties": false
    }
  }
}
