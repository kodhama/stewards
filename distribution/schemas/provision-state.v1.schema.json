{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodhama/stewards/distribution/schemas/provision-state.v1.schema.json",
  "title": "Canonical observed provision state v1",
  "type": "object",
  "required": [
    "schema_version",
    "host",
    "surface_id",
    "route_id",
    "selected_package",
    "kodhama_catalog_registration",
    "peer_selected_packages",
    "unselected_packages",
    "unselected_catalog_entries"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "host": { "enum": ["claude-code", "codex"] },
    "surface_id": {
      "$ref": "common-types.v1.schema.json#/$defs/dot_id"
    },
    "route_id": {
      "$ref": "common-types.v1.schema.json#/$defs/dot_id"
    },
    "selected_package": { "$ref": "#/$defs/package_state" },
    "kodhama_catalog_registration": {
      "$ref": "#/$defs/catalog_state"
    },
    "peer_selected_packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/peer_selected_package" }
    },
    "unselected_packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/installed_package" }
    },
    "unselected_catalog_entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/catalog_entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "package_state": {
      "oneOf": [
        {
          "type": "object",
          "required": ["presence"],
          "properties": { "presence": { "const": "absent" } },
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/installed_package"
        }
      ]
    },
    "installed_package": {
      "type": "object",
      "required": [
        "presence",
        "plugin_id",
        "package_version",
        "release_tag",
        "source_commit"
      ],
      "properties": {
        "presence": { "const": "installed" },
        "plugin_id": {
          "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
        },
        "package_version": {
          "$ref": "common-types.v1.schema.json#/$defs/semver"
        },
        "release_tag": {
          "$ref": "common-types.v1.schema.json#/$defs/release_tag"
        },
        "source_commit": {
          "$ref": "common-types.v1.schema.json#/$defs/source_commit"
        }
      },
      "additionalProperties": false
    },
    "catalog_state": {
      "oneOf": [
        {
          "type": "object",
          "required": ["presence"],
          "properties": { "presence": { "const": "absent" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "presence",
            "catalog_name",
            "manifest_path",
            "selector",
            "manifest_sha256"
          ],
          "properties": {
            "presence": { "const": "registered" },
            "catalog_name": {
              "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
            },
            "manifest_path": { "type": "string", "minLength": 1 },
            "selector": {
              "$ref": "common-types.v1.schema.json#/$defs/source_selector"
            },
            "manifest_sha256": {
              "$ref": "common-types.v1.schema.json#/$defs/sha256"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "peer_selected_package": {
      "type": "object",
      "required": [
        "plugin_id",
        "requested_package_version",
        "route_id",
        "observed_state"
      ],
      "properties": {
        "plugin_id": {
          "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
        },
        "requested_package_version": {
          "$ref": "common-types.v1.schema.json#/$defs/semver"
        },
        "route_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        },
        "observed_state": { "$ref": "#/$defs/package_state" }
      },
      "additionalProperties": false
    },
    "catalog_entry": {
      "type": "object",
      "required": [
        "entry_name",
        "selector",
        "installed_identity",
        "selector_fingerprint"
      ],
      "properties": {
        "entry_name": { "type": "string", "minLength": 1 },
        "selector": {
          "$ref": "common-types.v1.schema.json#/$defs/source_selector"
        },
        "installed_identity": { "$ref": "#/$defs/package_state" },
        "selector_fingerprint": {
          "$ref": "common-types.v1.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "state_body": {
      "type": "object",
      "required": [
        "selected_package",
        "kodhama_catalog_registration",
        "peer_selected_packages",
        "unselected_packages",
        "unselected_catalog_entries"
      ],
      "properties": {
        "selected_package": { "$ref": "#/$defs/package_state" },
        "kodhama_catalog_registration": {
          "$ref": "#/$defs/catalog_state"
        },
        "peer_selected_packages": {
          "type": "array",
          "items": { "$ref": "#/$defs/peer_selected_package" }
        },
        "unselected_packages": {
          "type": "array",
          "items": { "$ref": "#/$defs/installed_package" }
        },
        "unselected_catalog_entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/catalog_entry" }
        }
      },
      "additionalProperties": false
    }
  }
}
