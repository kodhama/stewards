{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodhama/stewards/distribution/schemas/legacy-stock.v1.schema.json",
  "title": "Removal-only transition stock v1",
  "type": "object",
  "required": ["schema_version", "initial_stock_reference", "rows"],
  "properties": {
    "schema_version": { "const": 1 },
    "initial_stock_reference": {
      "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
    },
    "rows": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "legacy-stock-initial.v1.schema.json#/$defs/stock_row"
      }
    }
  },
  "additionalProperties": false
}
