{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodhama/stewards/distribution/schemas/provisioner-availability.v1.schema.json",
  "title": "Provisioner availability v1",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "prerequisite": {
      "type": "object",
      "required": [
        "prerequisite_id",
        "request_reference_id",
        "kind",
        "description"
      ],
      "properties": {
        "prerequisite_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        },
        "request_reference_id": {
          "$ref": "common-types.v1.schema.json#/$defs/dot_id"
        },
        "kind": {
          "enum": [
            "authentication",
            "trust",
            "runtime",
            "configuration",
            "writable-state"
          ]
        },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "record": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "route_id",
            "surface_id",
            "plugin_id",
            "package_version",
            "state",
            "reason"
          ],
          "properties": {
            "route_id": {
              "$ref": "common-types.v1.schema.json#/$defs/dot_id"
            },
            "surface_id": {
              "$ref": "common-types.v1.schema.json#/$defs/dot_id"
            },
            "plugin_id": {
              "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
            },
            "package_version": {
              "$ref": "common-types.v1.schema.json#/$defs/semver"
            },
            "state": { "const": "unavailable" },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "route_id",
            "surface_id",
            "plugin_id",
            "package_version",
            "state",
            "provisioner_version",
            "adapter_path",
            "prerequisites",
            "missing_proof",
            "disclosure"
          ],
          "properties": {
            "route_id": {
              "$ref": "common-types.v1.schema.json#/$defs/dot_id"
            },
            "surface_id": {
              "$ref": "common-types.v1.schema.json#/$defs/dot_id"
            },
            "plugin_id": {
              "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
            },
            "package_version": {
              "$ref": "common-types.v1.schema.json#/$defs/semver"
            },
            "state": { "const": "candidate" },
            "provisioner_version": {
              "$ref": "common-types.v1.schema.json#/$defs/semver"
            },
            "adapter_path": {
              "$ref": "common-types.v1.schema.json#/$defs/relative_path"
            },
            "prerequisites": {
              "type": "array",
              "items": { "$ref": "#/$defs/prerequisite" }
            },
            "missing_proof": { "type": "string", "minLength": 1 },
            "disclosure": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "route_id",
            "surface_id",
            "plugin_id",
            "package_version",
            "state",
            "provisioner_version",
            "adapter_path",
            "prerequisites",
            "release_tag",
            "source_commit",
            "evidence_bundle"
          ],
          "properties": {
            "route_id": {
              "$ref": "common-types.v1.schema.json#/$defs/dot_id"
            },
            "surface_id": {
              "$ref": "common-types.v1.schema.json#/$defs/dot_id"
            },
            "plugin_id": {
              "$ref": "common-types.v1.schema.json#/$defs/plugin_id"
            },
            "package_version": {
              "$ref": "common-types.v1.schema.json#/$defs/semver"
            },
            "state": { "const": "verified" },
            "provisioner_version": {
              "$ref": "common-types.v1.schema.json#/$defs/semver"
            },
            "adapter_path": {
              "$ref": "common-types.v1.schema.json#/$defs/relative_path"
            },
            "prerequisites": {
              "type": "array",
              "items": { "$ref": "#/$defs/prerequisite" }
            },
            "release_tag": {
              "$ref": "common-types.v1.schema.json#/$defs/release_tag"
            },
            "source_commit": {
              "$ref": "common-types.v1.schema.json#/$defs/source_commit"
            },
            "evidence_bundle": {
              "$ref": "common-types.v1.schema.json#/$defs/stable_reference"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
